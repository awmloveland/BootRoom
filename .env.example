# Supabase — get from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Use ANON_KEY or PUBLISHABLE_KEY (Supabase Vercel integration may set the latter)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Hosted Supabase: add redirect URLs in Dashboard → Authentication → URL Configuration
# See SUPABASE_SETUP.md for the full list

# For data migration only (run scripts/migrate-data.mjs)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: lock production behind a secret URL key
# Only enforced on production; localhost works without a key
APP_ACCESS_KEY=your-secret-key

# Signs line-up share links so their preview image can show player names.
# Generate with: openssl rand -base64 32
SHARE_SIGNING_SECRET=your-random-secret

# Kick-off deadlines (Awaiting Result, unrecorded weeks, the next match card)
# are evaluated on the server clock. Set this on Vercel so it matches the league.
TZ=Europe/London
